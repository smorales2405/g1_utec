<?xml version="1.0" encoding="utf-8"?>
<!-- Inspire RH56E2 right hand alone, for isolated visualization.
     A world link holds the flange at the origin, fingers pointing up (+z), palm
     facing +x. -->
<robot name="inspire_rh56e2_hand_right" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find g1_edu_inspire_rh56e2_description)/urdf/inspire_rh56e2_hand_right.urdf.xacro"/>

  <link name="world"/>

  <xacro:inspire_hand_e2_right prefix="right_" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:inspire_hand_e2_right>

</robot>
