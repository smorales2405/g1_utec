        <material name="rh56e2_black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://g1_edu_inspire_rh56e2_description/meshes/hand_left/left_plam_1.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}palm_1_joint" type="fixed">
      <origin xyz="0 0 -0.031" rpy="-3.1416 0 0"/>
      <parent link="${prefix}hand_base_link"/>
      <child link="${prefix}palm_1"/>
    </joint>

    <!-- palm_2 -->
    <link name="${prefix}palm_2">
      <inertial>
        <origin xyz="-0.0282279108648417 -0.000242127035993855 0.0835826421996247" rpy="0 0 0"/>
        <mass value="0.0205046589058927"/>
        <inertia ixx="2.37671048423346E-05" ixy="-1.29072575162348E-08" ixz="-6.43764479926857E-08" iyy="1.27843040563581E-05" iyz="9.82907716155009E-08" izz="1.20351729261164E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://g1_edu_inspire_rh56e2_description/meshes/hand_left/left_plam_2.STL"/>
        </geometry>
        <material name="rh56e2_white">
          <color rgba="0.93 0.93 0.93 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://g1_edu_inspire_rh56e2_description/meshes/hand_left/left_plam_2.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}palm_2_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}palm_1"/>
      <child link="${prefix}palm_2"/>
    </joint>

    <!-- palm_force_sensor -->
    <link name="${prefix}palm_force_sensor">
      <inertial>
        <origin xyz="-0.00012009333519819 0.000717297413646942 -0.000692889069965077" rpy="0 0 0"/>
        <mass value="0.00240886556268154"/>
        <inertia ixx="1.79237847416138E-07" ixy="-3.62335250995994E-10" ixz="2.06838829667416E-10" iyy="5.01887324843563E-07" iyz="-4.23537057624356E-10" izz="6.80017237748538E-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://g1_edu_inspire_rh56e2_description/meshes/hand_left/left_plam_force_sensor.STL"/>
        </geometry>
        <material name="rh56e2_black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://g1_edu_inspire_rh56e2_description/meshes/hand_left/left_plam_force_sensor.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}palm_force_sensor_joint" type="fixed">
      <origin xyz="0.012296 -0.00036819 0.088601" rpy="1.5708 0 1.5708"/>
      <parent link="${prefix}palm_1"/>
      <child link="${prefix}palm_force_sensor"/>
    </joint>

    <!-- Three-finger grasp TCP -->
    <link name="${prefix}tcp">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-06"/>
        <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09"/>
      </inertial>
    </link>

    <joint name="${prefix}tcp_joint" type="fixed">
      <!-- Measured tcp position relative to base frame -->
       <origin xyz="0.105 0.0 -0.155" rpy="3.14 -1.0 0"/>
      <parent link="${prefix}hand_base_link"/>
      <child link="${prefix}tcp"/>
    </joint>

    <xacro:macro name="grasp_tcp" params="name xyz rpy">
      <link name="${prefix}tcp_${name}"/>
      <joint name="${prefix}tcp_${name}_joint" type="fixed">
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <parent link="${prefix}tcp"/>
        <child link="${prefix}tcp_${name}"/>
      </joint>
    </xacro:macro>

    <xacro:grasp_tcp name="three_fingers" xyz="0.0 -0.025 0.0" rpy="0 0 0"/>
    <xacro:grasp_tcp name="pinch" xyz="0.0 -0.030 0.0" rpy="0 0 0"/>
    <xacro:grasp_tcp name="full_hand" xyz="0.0 0.0 0.0" rpy="0 0 0"/>

  </xacro:macro>

</robot>
